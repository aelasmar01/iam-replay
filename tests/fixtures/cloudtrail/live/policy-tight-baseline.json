{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListAllBuckets",
      "Effect": "Allow",
      "Action": "s3:ListAllMyBuckets",
      "Resource": "*"
    },
    {
      "Sid": "ReadTheFixtureBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning"
      ],
      "Resource": "arn:aws:s3:::iam-replay-fixture-data-4351a7f9"
    },
    {
      "Sid": "ReadOwnRole",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:ListAttachedRolePolicies"
      ],
      "Resource": "arn:aws:iam::123456789012:role/iam-replay-fixture-workload"
    },
    {
      "Sid": "ListRoles",
      "Effect": "Allow",
      "Action": "iam:ListRoles",
      "Resource": "*"
    },
    {
      "Sid": "DescribeEc2",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeVpcs"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadOwnFunction",
      "Effect": "Allow",
      "Action": "lambda:GetFunction",
      "Resource": "arn:aws:lambda:us-east-1:123456789012:function:iam-replay-fixture-workload"
    },
    {
      "Sid": "ListFunctions",
      "Effect": "Allow",
      "Action": "lambda:ListFunctions",
      "Resource": "*"
    },
    {
      "Sid": "DescribeFixtureKey",
      "Effect": "Allow",
      "Action": "kms:DescribeKey",
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/d2024cc9-11fc-4b8c-b3fc-1e29e728399b"
    },
    {
      "Sid": "ListAliases",
      "Effect": "Allow",
      "Action": "kms:ListAliases",
      "Resource": "*"
    },
    {
      "Sid": "CreateScratchSecurityGroup",
      "Effect": "Allow",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": [
        "arn:aws:ec2:us-east-1:123456789012:security-group/*",
        "arn:aws:ec2:us-east-1:123456789012:vpc/*"
      ]
    },
    {
      "Sid": "DeleteScratchSecurityGroup",
      "Effect": "Allow",
      "Action": "ec2:DeleteSecurityGroup",
      "Resource": "arn:aws:ec2:us-east-1:123456789012:security-group/*"
    },
    {
      "Sid": "WriteScratchRolePolicy",
      "Effect": "Allow",
      "Action": [
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy"
      ],
      "Resource": "arn:aws:iam::123456789012:role/iam-replay-fixture-scratch"
    },
    {
      "Sid": "ManageScratchAlias",
      "Effect": "Allow",
      "Action": [
        "kms:CreateAlias",
        "kms:DeleteAlias"
      ],
      "Resource": "arn:aws:kms:us-east-1:123456789012:alias/iam-replay-fixture-scratch"
    },
    {
      "Sid": "AliasTargetKey",
      "Effect": "Allow",
      "Action": [
        "kms:CreateAlias",
        "kms:DeleteAlias"
      ],
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/d2024cc9-11fc-4b8c-b3fc-1e29e728399b"
    },
    {
      "Sid": "TagTheFixtureBucket",
      "Effect": "Allow",
      "Action": "s3:PutBucketTagging",
      "Resource": "arn:aws:s3:::iam-replay-fixture-data-4351a7f9"
    },
    {
      "Sid": "TagOwnFunction",
      "Effect": "Allow",
      "Action": [
        "lambda:TagResource",
        "lambda:UntagResource"
      ],
      "Resource": "arn:aws:lambda:us-east-1:123456789012:function:iam-replay-fixture-workload"
    },
    {
      "Sid": "AssumeTargetRole",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": "arn:aws:iam::123456789012:role/iam-replay-fixture-roles/iam-replay-fixture-target"
    },
    {
      "Sid": "WriteOwnLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:123456789012:log-group:/aws/lambda/iam-replay-fixture-workload:*"
    }
  ]
}
