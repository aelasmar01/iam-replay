[0.058, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.608, "o", "\u001b[2m# A deploy role, and a policy you are about to tighten.\u001b[0m\r\n"]
[1.613, "o", "\u001b[2m# First: replay its real CloudTrail history against the policy in force.\u001b[0m\r\n"]
[1.613, "o", "\u001b[1;32m❯\u001b[0m iam-replay --principal .../DeployRole --policy in-force.json --source files ...\r\n"]
[1.310, "o", "\u001b[1mPrincipal:\u001b[0m         arn:aws:iam::\u001b[1;36m123456789012\u001b[0m:role/iam-replay-fixture-workload\r\n"]
