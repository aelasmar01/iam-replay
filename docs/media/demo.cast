[1.348, "o", "\u001b[1;31mWOULD DENY\u001b[0m  \u001b[1m(\u001b[0m\u001b[1;36m2\u001b[0m\u001b[1m)\u001b[0m\r\n\u001b[1mAction                      \u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1mResource                            \u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1mCalls\u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1mSeen      \u001b[0m\u001b[1m \u001b[0m\u001b[1m \u001b[0m\u001b[1mWhy          \u001b[0m\r\niam:GetRole                   arn:aws:iam::123456789012:role/iam-r      6  2026-09-03  implicit deny\r\n                              eplay-fixture-workload                                                \r\niam:ListAttachedRolePolicies  arn:aws:iam::123456789012:role/iam-r      5  2026-09-03  implicit deny\r\n                              eplay-fixture-workload                                                \r\n\r\n\u001b[1;33mINDETERMINATE\u001b[0m  \u001b[1m(\u001b[0m\u001b[1;36m3\u001b[0m\u001b[1m)\u001b[0m\r\n  \u001b[2mThe event did not record what these statements depend on. Not a guess in either direction.\u001b[0m\r\n\r\n  \u001b[1mnever_available_condition_key\u001b[0m\r\n    s3:GetBucketLocation on arn:aws:s3:::iam-replay-fixture-data-4351a7f9 \u001b[2m×\u001b[0m\u001b[1;2;36m6\u001b[0m — unevaluable: \r\naws:ResourceTag/Project\r\n\r\n  \u001b[1"]
[0.000, "o", "mresource_policy_unevaluable\u001b[0m\r\n"]
[0.000, "o", "    s3:GetBucketVersioning on arn:aws:s3:::iam-replay-fixture-data-4351a7f9 \u001b[2m×\u001b[0m\u001b[1;2;36m5\u001b[0m\r\n\r\n  \u001b[1munknown_resource\u001b[0m\r\n    kms:DeleteAlias on \u001b[1m(\u001b[0mresource could not be determined\u001b[1m)\u001b[0m \u001b[2m×\u001b[0m\u001b[1;2;36m8\u001b[0m\r\n\r\n\u001b[1;36mNEW ACCESS\u001b[0m  \u001b[1m(\u001b[0m\u001b[1;36m0\u001b[0m\u001b[1m)\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2mIdentity-policy-only: a call denied by a resource policy — a KMS key policy or a role trust \u001b[0m\r\n\u001b[2mpolicy, both of which must explicitly allow the principal even within one account — may appear \u001b[0m\r\n\u001b[2mgrantable here when it is not.\u001b[0m\r\n"]
[0.000, "o", "  \u001b[2mnone\u001b[0m\r\n\r\n\u001b[1;32mWOULD ALLOW\u001b[0m  \u001b[1m(\u001b[0m\u001b[1;36m27\u001b[0m\u001b[1m)\u001b[0m\r\n"]
[4.514, "o", "\u001b[2m# Two calls break outright. Three more it refuses to guess at, and says why.\u001b[0m\r\n"]
[1.615, "o", "\u001b[2m# A wrong ALLOW breaks production. A wrong DENY destroys trust in the report.\u001b[0m\r\n"]
[1.616, "o", "\u001b[2m# Both are worse than an honest INDETERMINATE.\u001b[0m\r\n"]
[4.125, "x", "0"]
